{
  "name": "bbinstaller",
  "version": "0.1.0",
  "description": "Install .bar apps on BlackBerry 10 over USB, no developer mode needed",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node bb.test.js",
    "dist": "electron-builder --mac --win --linux"
  },
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.bbinstaller",
    "productName": "BB Installer",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "files": [
      "!bb.test.js"
    ],
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      },
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    },
    "linux": {
      "target": {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      "category": "Utility"
    }
  }
}
